// cSpell Settings
{
    // Version of the setting file.  Always 0.2
    "version": "0.2",
    // language - current active spelling language
    "language": "en",
    // Dictionaries to use.
    "dictionaries": [
        "en_US",
        "softwareTerms",
        "python",
        "html",
        "bash",
        // Filler text on the demo pages.
        "lorem-ipsum"
    ],
    // Files to skip, besides the files in .gitignore: third-party and minified files.
    "useGitignore": true,
    "ignorePaths": [
        "adminlte2_pdq/static/third-party/**",
        "**/*.min.css",
        "**/*.min.js",
        "**/*.map",
        "**/*.png",
        "**/*.jpg",
        "**/*.ico"
    ],
    // URL-encoded characters, such as the %2F in "%2Fsample%2F".
    "ignoreRegExpList": ["/%[0-9A-Fa-f]{2}/g"],
